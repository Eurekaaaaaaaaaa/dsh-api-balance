{
  "name": "dsh-api-balance",
  "version": "1.0.0",
  "description": "Shows DeepSeek and third-party API balances and quota in a floating status pill inside the DSH Web UI, with a generic HTTP provider you can point at any endpoint.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "balance",
    "quota",
    "billing"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Eurekaaaaaaaaaa/dsh-api-balance.git"
  },
  "homepage": "https://github.com/Eurekaaaaaaaaaa/dsh-api-balance#readme",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "tools/*.mjs",
    "TROUBLESHOOTING.md",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": false,
      "inject": [],
      "external": [
        "react",
        "react-dom"
      ]
    }
  }
}
